accruals:
  qualify_main_mode:
    events: 
      - left_ramp_shot_hit
      - right_ramp_shot_hit
    events_when_complete:
      - carousel_qualified
    disable_events: 
    enable_events:

counters:
  warp_qualify_counter:
    count_events: s_snikt_active
    starting_count: 0
    count_interval: 1
    direction: up
    count_complete_value: 3 + (current_player.pv_warp_mode_counter * 2)
    events_when_complete: start_mode_warp
    reset_on_complete: true
    disable_on_complete: false
  necron_lock_qualifier:
    count_events: s_droptarget_down_active
    starting_count: 0
    count_interval : 1
    direction: up
    count_complete_value: 1
    events_when_complete: 
        - reset_necron_drop 
    disable_on_complete: true
  necron_lock_qualifier2:
    count_events: s_droptarget_down_active
    starting_count: 0
    count_interval : 1
    direction: up
    count_complete_value: 2
    events_when_complete: 
        - reset_necron_drop 
    disable_on_complete: true
  necron_lock_qualifier3:
    count_events: s_droptarget_down_active
    starting_count: 0
    count_interval : 1
    direction: up
    count_complete_value: 3
    events_when_complete: start_necron_lock
    reset_on_complete: true
    disable_on_complete: true

