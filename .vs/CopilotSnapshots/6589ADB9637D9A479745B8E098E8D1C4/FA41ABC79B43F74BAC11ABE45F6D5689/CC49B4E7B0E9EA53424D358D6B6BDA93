shots: 
  left_orbit:
    switch: s_left_ramp
  left_slingshot:
    switch: s_left_slingshot
  right_slingshot:
    switch: s_right_slingshot
  pop_top:
    switch: s_pop_top
    profile: pop_profile
  pop_bottom:
    switch: s_pop_bottom
    profile: pop_profile
  left_drain:
    switch: s_left_outlane
  right_drain:
    switch: s_right_outlane


  mechanicus_scoop_shot:
    switch: s_scoop
    profile: generic_flash_profile
    show_tokens:
        led: l_adeptus_mechanicius
        color: lime 
    start_enabled: false
    enable_events: xenos_spotted
    #restart_events: inlane_lane_group_lit_complete


shot_groups: 
  start_select_mode_group:
    shots: mechanicus_scoop_shot
    reset_events: 
    enable_events: xenos_spotted
    disable_events: mechanicus_scoop_shot_hit_complete

shot_profiles: 
  pop_profile:
    states:
      - name: unlit
        show: off
      - name: hit
        show: pop_flash
        speed: 1
    loop: true

  generic_flash_profile:
    states:
      - name: lit
        show: generic_flash
      - name: unlit
        show: off
 
sequence_shots: 
  right_orbit:
    switch_sequence: s_right_orbit, s_innerloop_left
    sequence_timeout: 3s
  complete_inner_loop:
    switch_sequence: s_innerloop_right, s_innerloop_left, s_lowerloop
    sequence_timeout: 3s
   #Secret Combo Shots
    # Xenos Bank into the innder loop
  secret_combo_1:
